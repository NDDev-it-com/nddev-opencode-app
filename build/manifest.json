{
  "schema_version": 1,
  "name": "nddev-opencode-app",
  "build_version": "0.1.0",
  "entrypoint": "python3 cli-tools/nddev_opencode.py",
  "source_root": "setups",
  "setup_ids": [
    "safe",
    "balanced",
    "full-auto"
  ],
  "managed_files": [
    "opencode.json",
    "AGENTS.md",
    "plugins/nddev-builder.js",
    "skills/nddev-builder/SKILL.md",
    "agents/nddev-builder.md",
    "NDDEV-OPENCODE-SETUP.json",
    "NDDEV-OPENCODE-SOFTWARE.json"
  ],
  "builder": {
    "projection": "native",
    "marketplace": null,
    "native_surfaces": [
      "plugins",
      "skills",
      "agents"
    ],
    "managed_files": [
      "plugins/nddev-builder.js",
      "skills/nddev-builder/SKILL.md",
      "agents/nddev-builder.md"
    ]
  },
  "command_policy": {
    "json_supported": [
      "list",
      "status",
      "plan",
      "install",
      "apply",
      "switch",
      "restore",
      "remove",
      "software-status",
      "install-cli",
      "update-cli"
    ],
    "target_required": [
      "status",
      "plan",
      "install",
      "apply",
      "switch",
      "restore",
      "remove",
      "software-status",
      "install-cli",
      "update-cli",
      "launch"
    ],
    "plan_mutates": false,
    "restore_backup_option": "--backup <0..9>"
  },
  "runtime_launch": {
    "manager_command": "python3 cli-tools/nddev_opencode.py launch --target <absolute-target> -- [args...]",
    "direct_command": "<absolute-target>/bin/opencode [args...]",
    "environment_variables": [
      "OPENCODE_CONFIG",
      "OPENCODE_CONFIG_DIR",
      "HOME",
      "XDG_CONFIG_HOME",
      "XDG_DATA_HOME",
      "XDG_STATE_HOME",
      "XDG_CACHE_HOME"
    ],
    "target_environment_scope": "child-process-only",
    "requires_clean_managed_target": true,
    "requires_current_target_owned_software": true,
    "forwards_arguments": true,
    "forwards_child_exit_code": true
  },
  "software_lifecycle": {
    "stamp_file": "NDDEV-OPENCODE-SOFTWARE.json",
    "stamp_schema": 1,
    "status_command": "python3 cli-tools/nddev_opencode.py software-status --target <absolute-target> --json",
    "install_command": "python3 cli-tools/nddev_opencode.py install-cli --target <absolute-target> --json",
    "update_command": "python3 cli-tools/nddev_opencode.py update-cli --target <absolute-target> --json",
    "package_manager": "bun",
    "install_argv": [
      "add",
      "--global",
      "--exact",
      "--trust",
      "opencode-ai@1.18.6"
    ],
    "trust_required": true,
    "trust_reason": "Official opencode-ai@1.18.6 declares postinstall=node ./postinstall.mjs and platform optional packages",
    "target_owned": true,
    "software_root": ".nddev-opencode-software/current",
    "entrypoint": "bin/opencode",
    "entrypoint_kind": "bun-native-bin",
    "persisted_stage_paths": [
      "install/global",
      "bin"
    ],
    "ephemeral_stage_paths": [
      "home",
      "xdg-config",
      "cache",
      "tmp"
    ],
    "status_executes_binary": false,
    "staged_version_probe": [
      "bin/opencode",
      "--version"
    ],
    "registry": {
      "integrity": "sha512-MKombYcQfUlBFa6bo5ikev4nPcmHo4rI8q8KWfqFZFmNNqEutaXFYJKQHiUKE6nPOXcTI7T4sK7hicEYwL3S1w==",
      "shasum": "de8f32d2328a3f07891f263ce7f2b6f790324e13"
    },
    "credential_inheritance": false,
    "rollback_on_swap_failure": true
  },
  "backup_policy": {
    "location": "sibling .<target-name>.nddev-opencode-backups",
    "envelope": "NDDEV-OPENCODE-BACKUP.json",
    "slots": 10,
    "canonical_target_bound": true
  }
}
