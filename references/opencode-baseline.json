{
  "schema_version": 2,
  "verified_version_ref": "build/version.json:opencode_version",
  "runtime": {
    "product": "OpenCode",
    "command": "opencode",
    "tested_version_ref": "build/version.json:opencode_version",
    "minimum_version_ref": "build/version.json:opencode_min"
  },
  "release": {
    "github_release": "https://github.com/anomalyco/opencode/releases/tag/v1.18.15",
    "github_release_api": "https://api.github.com/repos/anomalyco/opencode/releases/tags/v1.18.15",
    "tag": "v1.18.15",
    "cli_signature": null,
    "cli_signature_note": "Official CLI zip/tar assets expose GitHub release asset SHA-256 digests but no PGP/cosign signature was published for the CLI assets."
  },
  "artifacts_ref": "build/version.json:artifacts",
  "artifact_product_host_map_ref": "build/version.json:artifact_product_host_map",
  "supported_product_hosts_ref": "build/version.json:supported_product_hosts",
  "unsupported_product_hosts_ref": "build/version.json:unsupported_product_hosts",
  "product_host_scope": {
    "supported": [
      "macos-arm64",
      "macos-x64",
      "ubuntu-glibc-arm64",
      "ubuntu-glibc-x64"
    ],
    "unsupported": [
      "windows",
      "non-ubuntu-linux",
      "linux-musl",
      "unsupported-architecture"
    ],
    "linux_distribution_metadata": "platform.freedesktop_os_release",
    "ubuntu_glibc_version_floor": null,
    "ubuntu_glibc_version_floor_note": "no-official-floor",
    "linux_vendor_artifact_names": "The upstream CLI release assets retain vendor names such as linux-x64 and linux-x64-baseline; nddev-opencode-app maps the glibc Linux artifacts only after the host is verified as ID=ubuntu and glibc."
  },
  "official_sources": {
    "repository": "https://github.com/anomalyco/opencode",
    "homepage": "https://opencode.ai/",
    "install_docs": "https://opencode.ai/docs/",
    "config_docs": "https://opencode.ai/docs/config/",
    "permissions_docs": "https://opencode.ai/docs/permissions/",
    "rules_docs": "https://opencode.ai/docs/rules/",
    "plugins_docs": "https://opencode.ai/docs/plugins/",
    "skills_docs": "https://opencode.ai/docs/skills/",
    "agents_docs": "https://opencode.ai/docs/agents/",
    "commands_docs": "https://opencode.ai/docs/commands/",
    "tools_docs": "https://opencode.ai/docs/tools/",
    "mcp_docs": "https://opencode.ai/docs/mcp-servers/",
    "cli_docs": "https://opencode.ai/docs/cli/",
    "npm_package": "https://registry.npmjs.org/opencode-ai/latest"
  },
  "configuration": {
    "config_file": "opencode.json",
    "custom_config_env": "OPENCODE_CONFIG",
    "custom_config_dir_env": "OPENCODE_CONFIG_DIR",
    "config_content_env": "OPENCODE_CONFIG_CONTENT",
    "project_config_disable_env": "OPENCODE_DISABLE_PROJECT_CONFIG",
    "share_disable_env": "OPENCODE_DISABLE_SHARE",
    "external_skills_disable_env": "OPENCODE_DISABLE_EXTERNAL_SKILLS",
    "claude_compat_disable_env": "OPENCODE_DISABLE_CLAUDE_CODE",
    "native_builder_projection": [
      "plugins/nddev-builder.js",
      "skills/nddev-builder/SKILL.md",
      "skills/nddev-builder/references/native-surfaces.md",
      "skills/nddev-builder/references/security-boundary.md",
      "agents/nddev-builder.md",
      "commands/nddev-orient.md",
      "commands/nddev-validate.md"
    ],
    "marketplace": null
  },
  "permissions": {
    "current_key": "permission",
    "legacy_tools_config_used": false,
    "actions": [
      "allow",
      "ask",
      "deny"
    ],
    "full_auto_shape": {
      "permission": "allow"
    }
  },
  "source_verified_runtime_flags": [
    "OPENCODE_DISABLE_PROJECT_CONFIG",
    "OPENCODE_DISABLE_EXTERNAL_SKILLS",
    "OPENCODE_DISABLE_CLAUDE_CODE",
    "OPENCODE_DISABLE_SHARE"
  ]
}
