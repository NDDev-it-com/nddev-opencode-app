{
  "contract_version": 1,
  "product_name": "nddev-opencode-app",
  "display_name": "NDDev OpenCode Setup Manager",
  "github_repository": "NDDev-it-com/nddev-opencode-app",
  "license": "AGPL-3.0-or-later",
  "description": "Dependency-free manager that installs, switches, restores, and removes selected OpenCode setup variants in an explicit isolated OpenCode config target.",
  "manifest_ref": "build/manifest.json",
  "version_ref": "build/version.json",
  "source_root": "setups",
  "setup_system": {
    "catalog_root": "setups",
    "setup_ids": [
      "safe",
      "balanced",
      "full-auto"
    ],
    "selection_option": "--setup <id>",
    "list_command": "python3 cli-tools/nddev_opencode.py list [--json]",
    "status_command": "python3 cli-tools/nddev_opencode.py status --target <absolute-target> [--json]",
    "plan_command": "python3 cli-tools/nddev_opencode.py plan --setup <id> --target <absolute-target> [--json]",
    "install_command": "python3 cli-tools/nddev_opencode.py install --setup <id> --target <absolute-target> [--json]",
    "switch_command": "python3 cli-tools/nddev_opencode.py switch --setup <id> --target <absolute-target> [--json]",
    "restore_command": "python3 cli-tools/nddev_opencode.py restore --backup <0..9> --target <absolute-target> [--json]",
    "remove_command": "python3 cli-tools/nddev_opencode.py remove --target <absolute-target> [--json]",
    "plan_mutates": false
  },
  "managed_state": {
    "target_env": "OPENCODE_CONFIG_DIR",
    "config_file": "opencode.json",
    "stamp_file": "NDDEV-OPENCODE-SETUP.json",
    "stamp_schema": 1,
    "backup_slots": 10,
    "managed_file_mode": "0600",
    "new_target_mode": "0700",
    "managed_files": [
      "opencode.json",
      "AGENTS.md",
      "plugins/nddev-builder.js",
      "skills/nddev-builder/SKILL.md",
      "agents/nddev-builder.md"
    ],
    "managed_config_keys": [
      "autoupdate",
      "share",
      "permission"
    ],
    "preserve_other_state": true
  },
  "builder": {
    "id": "nddev-builder",
    "projection": "native",
    "marketplace": null,
    "native_surfaces": {
      "plugin_directory": "plugins/",
      "skill_directory": "skills/nddev-builder/SKILL.md",
      "agent_directory": "agents/nddev-builder.md"
    },
    "managed_files": [
      "plugins/nddev-builder.js",
      "skills/nddev-builder/SKILL.md",
      "agents/nddev-builder.md"
    ],
    "enabled_in_setups": [
      "safe",
      "balanced",
      "full-auto"
    ]
  },
  "runtime_launch": {
    "manager_command": "python3 cli-tools/nddev_opencode.py launch --target <absolute-target> -- [args...]",
    "direct_command": "<absolute-target>/bin/opencode [args...]",
    "requires_clean_managed_target": true,
    "forwards_arguments": true,
    "forwards_child_exit_code": true,
    "target_environment_scope": "child-process-only",
    "successful_child_output_wrapped": false
  },
  "software_lifecycle": {
    "stamp_file": "NDDEV-OPENCODE-SOFTWARE.json",
    "stamp_schema": 1,
    "status_executes_binary": false,
    "install_precondition": "install-cli refuses any existing target-owned software presence unless it is already current",
    "update_precondition": "update-cli repairs existing target-owned software presence and refuses absent software state",
    "package_manager": "bun",
    "install_argv": [
      "add",
      "--global",
      "--exact",
      "--trust",
      "opencode-ai@1.18.5"
    ],
    "trust_required": true,
    "trust_reason": "Official opencode-ai@1.18.5 declares postinstall=node ./postinstall.mjs and platform optional packages",
    "target_owned": true,
    "software_root": ".nddev-opencode-software/current",
    "entrypoint": "bin/opencode",
    "entrypoint_kind": "bun-native-bin",
    "persisted_stage_paths": [
      "install/global",
      "bin"
    ],
    "ephemeral_stage_paths": [
      "home",
      "xdg-config",
      "cache",
      "tmp"
    ],
    "stage_env": {
      "BUN_INSTALL_GLOBAL_DIR": "<stage>/install/global",
      "BUN_INSTALL_BIN": "<stage>/bin",
      "BUN_INSTALL_CACHE_DIR": "<stage>/cache",
      "HOME": "<stage>/home",
      "XDG_CONFIG_HOME": "<stage>/xdg-config",
      "TMPDIR": "<stage>/tmp"
    },
    "staged_version_probe": [
      "bin/opencode",
      "--version"
    ],
    "registry": {
      "integrity": "sha512-Q0jlX4ihn7veMeYsLX3c4PYFAKIURU3GIpXt1FnhNxNn3v8+RpIZ8z9umG5D0r8g8Smp9fZLGjgLe/9mJ4NyYw==",
      "shasum": "91dcee1ca87ac6f445b4fbf7a3375de170acbfe6"
    },
    "credential_inheritance": false,
    "rollback_on_swap_failure": true
  },
  "safety": {
    "absolute_target_required": true,
    "default_target": null,
    "relative_target_rejected": true,
    "target_symlinks_rejected": true,
    "canonical_target_binding": true,
    "preserve_unmanaged_files": true,
    "preserve_unmanaged_config_keys": true,
    "reject_symlink_managed_files": true,
    "reject_hardlinked_managed_files": true,
    "rollback_on_failure": true,
    "bounded_reads": true,
    "max_backups": 10
  },
  "runtime_compatibility": {
    "product": "OpenCode",
    "version_ref": "build/version.json",
    "baseline_ref": "references/opencode-baseline.json",
    "official_source": {
      "repository": "https://github.com/anomalyco/opencode",
      "docs": "https://opencode.ai/docs/"
    },
    "official_docs": {
      "config": "https://opencode.ai/docs/config/",
      "permissions": "https://opencode.ai/docs/permissions/",
      "plugins": "https://opencode.ai/docs/plugins/",
      "skills": "https://opencode.ai/docs/skills/",
      "agents": "https://opencode.ai/docs/agents/"
    }
  }
}
